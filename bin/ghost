#!/usr/bin/env bash
# Ghost Bus: lets AI agents on one Linux machine message, wake and lock each other.
# Documentation: GHOST-BUS.md
#
# Usage:
#   ghost init    [<dir>]                  create a bus (<dir>/.ghosts, default: current folder)
#   ghost send    <from> <to> <type> "<text>" [--body "<body>"] [--ref <ref>]
#   ghost wait    <me> [--timeout <seconds>]
#   ghost state   <me> <listening|working|reviewing|blocked|off> ["<task>"]
#   ghost lock    {status|acquire|release|steal} [<resource>] [<me>] ["<reason>"]
#   ghost status
#   ghost log     [n]
#   ghost install                          post every commit of this git repo to the bus
#   ghost help
#
# The bus is $GHOST_DIR, or the nearest .ghosts folder in the current folder or its parents.
set -euo pipefail

SELF="$(readlink -f "${BASH_SOURCE[0]}")"
POLL="${GHOST_POLL:-1}"
SETTLE="${GHOST_SETTLE:-2}"
HOOK_MARK="# ghost-bus post-commit hook"

die() { echo "ghost: $*" >&2; exit 2; }
now_iso() { date -u +"%Y-%m-%dT%H:%M:%SZ"; }
usage() { sed -n '/^# Usage:/,/^set -/p' "$SELF" | sed '/^set -/d; s/^# \{0,1\}//'; }

for tool in jq flock; do command -v "$tool" >/dev/null || die "$tool is required"; done

# ---------------------------------------------------------------- bus and config

find_bus() {
    if [ -n "${GHOST_DIR:-}" ]; then echo "$GHOST_DIR"; return; fi
    local d="$PWD"
    while :; do
        if [ -d "$d/.ghosts" ]; then echo "$d/.ghosts"; return; fi
        [ "$d" = "/" ] && return 1
        d="$(dirname "$d")"
    done
}

# Defaults; <bus>/config overrides them.
AGENTS="claude agy gpt cod gem"
HUMAN="human"
ALIASES=""
PROJECTS=""
STALE_MINUTES=90

# The config is parsed, never executed.
load_config() {
    local f="$GH/config" key value
    [ -f "$f" ] || return 0
    while IFS='=' read -r key value || [ -n "$key" ]; do
        key="$(tr -d '[:space:]' <<<"${key%%#*}")"
        value="$(sed -E 's/#.*$//; s/^[[:space:]]+//; s/[[:space:]]+$//' <<<"$value")"
        case "$key" in
            "") ;;
            agents)        AGENTS="$value" ;;
            human)         HUMAN="$value" ;;
            aliases)       ALIASES="$value" ;;
            projects)      PROJECTS="$value" ;;
            stale_minutes) STALE_MINUTES="$value" ;;
            *) die "unknown setting '$key' in $f" ;;
        esac
    done < "$f"
    local a
    [ -n "$AGENTS" ] || die "'agents' is empty in $f"
    for a in $AGENTS; do [[ "$a" =~ ^[a-z0-9]+$ ]] || die "invalid agent name '$a' (use a-z and 0-9)"; done
    [[ "$HUMAN" =~ ^[a-z0-9]+$ ]] || die "invalid human name '$HUMAN' (use a-z and 0-9)"
    [[ "$STALE_MINUTES" =~ ^[0-9]+$ ]] || die "stale_minutes must be a number"
}

# Look up <key> in a list of "key:value" words.
lookup() {
    local key="$1" list="$2" pair
    for pair in $list; do
        if [ "${pair%%:*}" = "$key" ]; then echo "${pair#*:}"; return 0; fi
    done
    return 1
}

# Project slug: GHOST_PROJECT, or the name of the git repo / current folder.
detect_project() {
    local name slug
    name="${GHOST_PROJECT:-$(basename "$(git rev-parse --show-toplevel 2>/dev/null || pwd)")}"
    slug="$(tr '[:upper:]' '[:lower:]' <<<"$name" | sed -E 's/[^a-z0-9]+/-/g; s/^-+//; s/-+$//')"
    lookup "$slug" "$PROJECTS" || echo "${slug:-project}"
}

cmd_init() {
    local dir="${1:-$PWD}" g
    [ -d "$dir" ] || die "no such folder: $dir"
    g="$(cd "$dir" && pwd)/.ghosts"
    [ ! -e "$g" ] || die "$g already exists"
    mkdir -p "$g/locks"
    : > "$g/bus.jsonl"
    printf '*\n' > "$g/.gitignore"
    cat > "$g/config" <<'CONF'
# Ghost Bus settings (see GHOST-BUS.md)
agents        = claude agy gpt cod gem
human         = human
# short names for agents, e.g.  aliases = cld:claude
aliases       =
# short names for projects, e.g.  projects = my-very-long-repo-name:short
projects      =
stale_minutes = 90
CONF
    echo "Ghost Bus created in $g"
}

# ---------------------------------------------------------------- names

is_agent() {
    local a
    for a in $AGENTS; do [ "$a" = "${1:-}" ] && return 0; done
    return 1
}

# Full instance name: <project>-<agent>. The project may contain hyphens, the agent may not.
is_instance() {
    [[ "${1:-}" =~ ^[a-z0-9]+(-[a-z0-9]+)*-[a-z0-9]+$ ]] && is_agent "${1##*-}"
}

# Sender: 'claude' -> '<project>-claude'.
norm_agent() {
    local a="${1:-}"
    a="$(lookup "$a" "$ALIASES" || echo "$a")"
    if is_agent "$a"; then echo "$PROJECT-$a"
    elif is_instance "$a" || [ "$a" = "$HUMAN" ] || [ "$a" = "unknown" ]; then echo "$a"
    else return 1; fi
}

# Recipient: also 'all' (this project), '*' (everyone), '<project>-*', '*-<agent>' and 'log' (nobody).
norm_to() {
    local t="${1:-}"
    case "$t" in
        all)      echo "$PROJECT-*"; return ;;
        "*")      echo "*"; return ;;
        log)      echo "log"; return ;;
        "*-"*)    if is_agent "${t#\*-}"; then echo "$t"; return; else return 1; fi ;;
        *"-*")    if [[ "${t%-\*}" =~ ^[a-z0-9]+(-[a-z0-9]+)*$ ]]; then echo "$t"; return; else return 1; fi ;;
    esac
    norm_agent "$t"
}

agent_of() { echo "${1##*-}"; }
project_of() { echo "${1%-*}"; }

# ---------------------------------------------------------------- processes and files

proc_start() { if [ -r "/proc/$1/stat" ]; then sed -E 's/^.*\) //' "/proc/$1/stat" | awk '{print $20}'; fi; }

find_agent_pid() {
    local me="$1" agent p="$$" comm
    agent="$(agent_of "$me")"
    if [ -n "${GHOST_AGENT_PID:-}" ]; then echo "$GHOST_AGENT_PID"; return; fi
    while [ "$p" -gt 1 ] 2>/dev/null; do
        comm="$(cat "/proc/$p/comm" 2>/dev/null || true)"
        if [ "$comm" = "$agent" ] || [ "$comm" = "$me" ]; then echo "$p"; return; fi
        p="$(sed -E 's/^.*\) //' "/proc/$p/stat" 2>/dev/null | awk '{print $2}' || true)"
        [ -n "$p" ] || break
    done
}

pid_matches() {
    [ -n "$1" ] && kill -0 "$1" 2>/dev/null || return 1
    [ -z "${2:-}" ] || [ "$(proc_start "$1")" = "$2" ]
}

is_ghost_pid() { [ -n "$1" ] && kill -0 "$1" 2>/dev/null && grep -qa "ghost" "/proc/$1/cmdline" 2>/dev/null; }

watcher_alive() {
    local f="$GH/watch.$1.json"
    [ -f "$f" ] && is_ghost_pid "$(jq -r '.watcherPid // empty' "$f")"
}

write_atomic() { local f="$1" tmp; tmp="$(mktemp "$f.XXXX")"; cat > "$tmp"; mv -f "$tmp" "$f"; }
cursor_file() { echo "$GH/cursor.$1"; }
read_cursor() { cat "$(cursor_file "$1")" 2>/dev/null || true; }

write_presence() {
    local me="$1" state="$2" task="$3" apid start=""
    apid="$(find_agent_pid "$me")"
    [ -z "$apid" ] || start="$(proc_start "$apid")"
    jq -n --arg agent "$me" --arg state "$state" --arg task "$task" --arg since "$(now_iso)" \
          --arg pid "$apid" --arg start "$start" \
          '{agent:$agent, state:$state, task:$task, since:$since,
            agentPid:($pid|if .=="" then null else tonumber end),
            agentStart:($start|if .=="" then null else . end)}' \
        | write_atomic "$GH/presence.$me.json"
}

# ---------------------------------------------------------------- bus

snapshot() {
    exec 8>>"$BUSLOCK"
    flock -s 8
    sed '/^$/d' "$BUS"
    flock -u 8
}

# Sequence number of the last event on stdin; 0 if there is none. Fails on a damaged line.
last_seq_of() {
    local last; last="$(tail -n 1)"
    if [ -z "$last" ]; then echo 0; else jq -er '.seq' <<<"$last"; fi
}

fmt_events() {
    jq -r '"#\(.seq) \(.ts) \(.from) → \(.to) [\(.type)] \(.text)"
           + (if (.ref // "") != "" then "  (ref: \(.ref))" else "" end)
           + (if (.body // "") != "" then "\n   " + ((.body) | gsub("\n"; "\n   ")) else "" end)'
}

unread_for() {
    local me="$1" cursor="$2"
    jq -c --arg me "$me" --arg pwild "$(project_of "$me")-*" --arg awild "*-$(agent_of "$me")" --argjson cur "$cursor" \
        'select(.seq > $cur and .from != $me and (.to == $me or .to == $pwild or .to == $awild or .to == "*"))'
}

cmd_send() {
    [ $# -ge 4 ] || die "usage: ghost send <from> <to> <type> \"<text>\" [--body \"<body>\"] [--ref <ref>]"
    local raw_from="$1" raw_to="$2" type="$3" text="$4" body="" ref="" from to proj seq line
    shift 4
    while [ $# -gt 0 ]; do
        [ $# -ge 2 ] || die "missing value for $1"
        case "$1" in
            --body) body="$2" ;;
            --ref)  ref="$2" ;;
            *) die "unknown option: $1" ;;
        esac
        shift 2
    done
    from="$(norm_agent "$raw_from")" || die "invalid sender: $raw_from (use <agent>, <project>-<agent> or $HUMAN; agents: $AGENTS)"
    to="$(norm_to "$raw_to")" || die "invalid recipient: $raw_to (use <agent>, <project>-<agent>, all, <project>-*, *-<agent>, * or log)"
    case "$type" in
        message|question|answer|spark|accept|request|review-request|pass|fail|done|commit|lock) ;;
        *) die "unknown event type: $type" ;;
    esac
    [ -n "$text" ] || die "text is empty"

    if is_instance "$from"; then proj="$(project_of "$from")"; else proj="$PROJECT"; fi
    exec 9>>"$BUSLOCK"
    flock 9
    seq="$(sed '/^$/d' "$BUS" | last_seq_of)" || die "damaged last line in $BUS"
    seq=$(( seq + 1 ))
    line="$(jq -cn --argjson seq "$seq" --arg ts "$(now_iso)" --arg from "$from" --arg to "$to" \
                   --arg project "$proj" --arg type "$type" --arg text "$text" --arg body "$body" --arg ref "$ref" \
                   '{seq:$seq, ts:$ts, from:$from, to:$to, project:$project, type:$type, text:$text}
                    + (if $body != "" then {body:$body} else {} end)
                    + (if $ref != "" then {ref:$ref} else {} end)')"
    printf '%s\n' "$line" >> "$BUS"
    flock -u 9
    echo "sent #$seq $from → $to [$type]"
}

cmd_wait() {
    local raw_me="${1:-}" timeout=0 me
    shift || true
    me="$(norm_agent "$raw_me")" && is_instance "$me" || die "usage: ghost wait <agent> [--timeout <seconds>] (agents: $AGENTS)"
    while [ $# -gt 0 ]; do
        case "$1" in
            --timeout) timeout="${2:-}"; [[ "$timeout" =~ ^[0-9]+$ ]] || die "--timeout needs a number of seconds"; shift 2 ;;
            *) die "unknown option: $1" ;;
        esac
    done

    # One waiter per instance.
    WATCHF="$GH/watch.$me.json"
    PIDF="$GH/wait.$me.pid"
    local old; old="$(cat "$PIDF" 2>/dev/null || true)"
    if [ "$old" != "$$" ] && is_ghost_pid "$old"; then
        echo "ghost: $me already has an active waiter (pid $old)" >&2
        exit 4
    fi
    echo "$$" > "$PIDF"
    trap 'rm -f "$WATCHF" "$PIDF"' EXIT

    local cursor snap events maxseq started last_beat=0 now
    cursor="$(read_cursor "$me")"
    if [ -z "$cursor" ]; then
        cursor="$(snapshot | last_seq_of)"
        echo "$cursor" > "$(cursor_file "$me")"
    fi
    write_presence "$me" listening "waiting for events"
    started="$(date +%s)"

    while true; do
        snap="$(snapshot)"
        events="$(unread_for "$me" "$cursor" <<<"$snap")"
        if [ -n "$events" ]; then
            sleep "$SETTLE"     # let a burst of events arrive
            snap="$(snapshot)"
            events="$(unread_for "$me" "$cursor" <<<"$snap")"
            maxseq="$(last_seq_of <<<"$snap")"
            echo "========================================================"
            echo "👻 $(wc -l <<<"$events") event(s) for $me:"
            fmt_events <<<"$events"
            echo "========================================================"
            echo "$maxseq" > "$(cursor_file "$me")"
            write_presence "$me" working "handling bus events up to #$maxseq"
            exit 0
        fi
        now="$(date +%s)"
        if [ $(( now - last_beat )) -ge 5 ]; then
            jq -n --argjson pid "$$" --argjson seen "$now" '{watcherPid:$pid, lastSeen:$seen}' | write_atomic "$WATCHF"
            last_beat="$now"
        fi
        if [ "$timeout" -gt 0 ] && [ $(( now - started )) -ge "$timeout" ]; then exit 3; fi
        sleep "$POLL"
    done
}

cmd_state() {
    local state="${2:-}" task="${3:-}" me
    me="$(norm_agent "${1:-}")" && is_instance "$me" || die "usage: ghost state <agent> <listening|working|reviewing|blocked|off> [\"<task>\"]"
    case "$state" in listening|working|reviewing|blocked|off) ;; *) die "state must be listening|working|reviewing|blocked|off" ;; esac
    write_presence "$me" "$state" "$task"
    echo "$me is $state${task:+: $task}"
}

# ---------------------------------------------------------------- locks

lock_name() { sed -E 's/[^A-Za-z0-9._-]+/-/g' <<<"$1"; }

# Holder of the repo lock of the current project, or 'unknown'.
repo_lock_holder() {
    local h; h="$(jq -r '.holder // empty' "$GH/locks/lock.$(lock_name "repo:$PROJECT").json" 2>/dev/null || true)"
    echo "${h:-unknown}"
}

write_lock() {   # <file> <resource> <holder> <turn>
    jq -n --arg r "$2" --arg h "$3" --arg t "$4" --arg ts "$(now_iso)" --argjson e "$(date +%s)" \
        '{resource:$r, holder:(if $h=="" then null else $h end), turn:(if $h=="" then null else $t end), changedUtc:$ts, epoch:$e}' \
        | write_atomic "$1"
}

cmd_lock() {
    local action="${1:-status}" resource="${2:-}" raw_me="${3:-}" desc="${4:-}" me="" name lf wf holder epoch turn age w
    if [ "$action" = "status" ] && [ -z "$resource" ]; then
        shopt -s nullglob
        local files=("$GH"/locks/lock.*.json) f
        [ "${#files[@]}" -gt 0 ] || echo "No locks recorded."
        for f in "${files[@]}"; do cmd_lock status "$(jq -r '.resource' "$f")"; done
        return 0
    fi
    [ -n "$resource" ] || die "usage: ghost lock {status|acquire|release|steal} <resource> [<me>] [\"<reason>\"]"
    name="$(lock_name "$resource")"
    lf="$GH/locks/lock.$name.json"
    wf="$GH/locks/waiters.$name"
    case "$action" in
        status) ;;
        acquire|release|steal)
            me="$(norm_agent "$raw_me")" && [ "$me" != "unknown" ] || die "usage: ghost lock $action <resource> <me> [\"<reason>\"]"
            [ "$action" != steal ] || [ -n "$desc" ] || die "steal needs a reason"
            # Check and change the lock as one step.
            exec 7>>"$GH/locks/mutex"
            flock 7 ;;
        *) die "unknown lock action: $action" ;;
    esac
    holder="$(jq -r '.holder // empty' "$lf" 2>/dev/null || true)"
    epoch="$(jq -r '.epoch // 0' "$lf" 2>/dev/null || echo 0)"
    turn="$(jq -r '.turn // empty' "$lf" 2>/dev/null || true)"
    age=$(( $(date +%s) - epoch ))

    case "$action" in
        status)
            if [ -z "$holder" ]; then
                printf 'LOCK %-24s FREE\n' "$resource"
            else
                printf 'LOCK %-24s HELD by %s (%ss)%s :: %s\n' "$resource" "$holder" "$age" \
                    "$( [ "$age" -le $(( STALE_MINUTES * 60 )) ] || echo ' [STALE]')" "$turn"
            fi
            ;;
        acquire)
            if [ -n "$holder" ] && [ "$holder" != "$me" ]; then
                grep -qxF "$me" "$wf" 2>/dev/null || echo "$me" >> "$wf"
                echo "REFUSED $resource: held by $holder (${age}s) :: $turn"
                return 1
            fi
            write_lock "$lf" "$resource" "$me" "$desc"
            if [ -f "$wf" ]; then { grep -vxF "$me" "$wf" || true; } | write_atomic "$wf"; fi
            cmd_send "$me" log lock "acquired $resource${desc:+: $desc}" >/dev/null
            echo "ACQUIRED $resource by $me${desc:+ :: $desc}"
            ;;
        release)
            if [ "$holder" != "$me" ]; then
                echo "NOOP $resource: not held by $me (holder: ${holder:-none})"
                return 1
            fi
            write_lock "$lf" "$resource" "" ""
            cmd_send "$me" log lock "released $resource" >/dev/null
            if [ -f "$wf" ]; then
                while read -r w; do
                    [ "$w" = "$me" ] || cmd_send "$me" "$w" lock "lock $resource released by $me, it's free" >/dev/null
                done < "$wf"
                rm -f "$wf"
            fi
            echo "RELEASED $resource by $me"
            ;;
        steal)
            write_lock "$lf" "$resource" "$me" "STOLEN: $desc"
            cmd_send "$me" "*" lock "stole $resource from ${holder:-none}: $desc" >/dev/null
            echo "STOLEN $resource by $me (was: ${holder:-free})"
            ;;
    esac
}

# ---------------------------------------------------------------- overview

cmd_status() {
    local snap pf a state task since apid astart verdict cursor unread
    snap="$(snapshot)"
    echo "=== Ghost Bus ($GH) ==="
    shopt -s nullglob
    local pfiles=("$GH"/presence.*.json)
    [ "${#pfiles[@]}" -gt 0 ] || echo "No agent has used this bus yet."
    for pf in "${pfiles[@]}"; do
        a="${pf##*/presence.}"; a="${a%.json}"
        state="$(jq -r '.state' "$pf")"; task="$(jq -r '.task // ""' "$pf")"; since="$(jq -r '.since' "$pf")"
        apid="$(jq -r '.agentPid // empty' "$pf")"; astart="$(jq -r '.agentStart // empty' "$pf")"
        if [ -z "$apid" ]; then
            if watcher_alive "$a"; then verdict="LISTENING (agent process unknown)"; else verdict="UNKNOWN (agent process unknown)"; fi
        elif pid_matches "$apid" "$astart"; then
            if watcher_alive "$a"; then
                verdict="LISTENING"
                [ "$state" = "listening" ] || verdict="LISTENING · ${state^^}"
            elif [ "$state" = "listening" ]; then verdict="NOT LISTENING (waiter stopped; agent alive)"
            else verdict="${state^^}"; fi
        elif watcher_alive "$a"; then verdict="ORPHANED (waiter runs, agent gone)"
        elif [ "$state" = "off" ]; then verdict="OFF"
        else verdict="GONE (agent process ended)"; fi
        cursor="$(read_cursor "$a")"
        unread="$(unread_for "$a" "${cursor:-0}" <<<"$snap" | wc -l)"
        printf '%-24s %-44s unread: %-3s since %s%s\n' "$a" "$verdict" "$unread" "$since" "${task:+ · $task}"
    done
    echo
    cmd_lock status
    echo
    echo "Recent events:"
    tail -n 5 <<<"$snap" | fmt_events
}

cmd_log() {
    local n="${1:-20}"
    [[ "$n" =~ ^[0-9]+$ ]] || die "usage: ghost log [n]"
    snapshot | tail -n "$n" | fmt_events
}

# ---------------------------------------------------------------- git hook

# Never replaces a hook that isn't ours and never changes the git configuration.
cmd_install() {
    git rev-parse --show-toplevel >/dev/null 2>&1 || die "not inside a git repository"
    local hook qself
    printf -v qself '%q' "$SELF"
    local call="$qself hook-commit >/dev/null 2>&1 || true"
    if [ -n "$(git config core.hooksPath || true)" ]; then
        die "core.hooksPath is set; add this line to your post-commit hook yourself: $call"
    fi
    hook="$(git rev-parse --git-path hooks)/post-commit"
    if [ -e "$hook" ] && ! grep -qF "$HOOK_MARK" "$hook"; then
        die "$hook already exists; add this line to it yourself: $call"
    fi
    mkdir -p "$(dirname "$hook")"
    printf '#!/usr/bin/env bash\n%s: posts every commit, never fails it.\n%s\nexit 0\n' "$HOOK_MARK" "$call" > "$hook"
    chmod +x "$hook"
    echo "Installed $hook"
}

cmd_hook_commit() {
    cmd_send "$(repo_lock_holder)" all commit "$(git log -1 --format='%h %s')" --ref "$(git rev-parse HEAD)"
}

# ---------------------------------------------------------------- main

cmd="${1:-status}"; shift || true
case "$cmd" in
    help|-h|--help) usage; exit 0 ;;
    init) cmd_init "$@"; exit 0 ;;
esac

GH="$(find_bus)" || die "no bus found; run 'ghost init' in your workspace folder or set GHOST_DIR"
BUS="$GH/bus.jsonl"
BUSLOCK="$GH/bus.lock"
mkdir -p "$GH/locks"
touch "$BUS"
load_config
PROJECT="$(detect_project)"

case "$cmd" in
    send)        cmd_send "$@" ;;
    wait)        cmd_wait "$@" ;;
    state)       cmd_state "$@" ;;
    lock)        cmd_lock "$@" ;;
    status)      cmd_status ;;
    log)         cmd_log "$@" ;;
    install)     cmd_install ;;
    hook-commit) cmd_hook_commit ;;
    *)           die "unknown command: $cmd (try: ghost help)" ;;
esac
